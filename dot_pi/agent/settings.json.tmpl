{
    "lastChangelogVersion": "1.3.0",
    "theme": "light",
    "packages": [
        "npm:pi-web-access",
        "npm:pi-subagents",
        "npm:@juicesharp/rpiv-ask-user-question"
    ],
    "extensions": [],
    "hideThinkingBlock": false,
    "outputPad": 1,
    "editorPaddingX": 1,
{{if eq .chezmoi.hostname "gca-7sjgnd4"}}
    "defaultProvider": "Toyon vLLM",
    "defaultModel": "nemotron-3.5-super-vl",
    "enabledModels": [
        "Toyon vLLM/nemotron-3.5-super-vl",
        "Amazon Bedrock Mantle (GovCloud)/anthropic.claude-opus-5-5"
    ]
{{else}}
    "defaultProvider": "openrouter",
    "defaultModel": "deepseek/deepseek-v4.1-flash",
    "modelThinkingLevels": {
        "openrouter/deepseek/deepseek-v4-flash": "xhigh"
    },
    "enabledModels": [
        "openrouter/deepseek/deepseek-v4.1-flash",
        "openrouter/z-ai/glm-5.3",
        "openrouter/qwen/qwen3.7-max"
    ]
{{end}}
}
